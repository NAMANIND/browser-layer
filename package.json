{
  "name": "agent-layer",
  "version": "0.0.1",
  "description": "Websites as text and verbs for agents. No browser, no paint.",
  "type": "module",
  "bin": {
    "agent-layer": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "test": "tsx --test test/*.test.ts",
    "measure": "tsc && node bench/measure.mjs",
    "record": "node bench/record-corpus.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "parse5": "^8.0.1",
    "playwright-core": "^1.64.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
