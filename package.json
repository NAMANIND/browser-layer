{
  "name": "agent-layer",
  "version": "0.1.0",
  "description": "A terminal browser for AI agents: pages as text maps, actions that answer with what changed, lists as records. Runs headless Chrome, Edge or Chromium.",
  "keywords": [
    "agent",
    "ai",
    "browser",
    "cli",
    "automation",
    "headless",
    "chrome",
    "llm",
    "web"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "agent-layer": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "dev": "tsx src/cli.ts",
    "test": "tsx --test test/*.test.ts",
    "measure": "tsc && node bench/measure.mjs",
    "record": "node bench/record-corpus.mjs",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "parse5": "^8.0.1",
    "playwright-core": "^1.64.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
